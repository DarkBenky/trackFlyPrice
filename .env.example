# Every key below is optional except FROM/TO and the date windows.
# Values shown are the defaults the code uses.

# ─── Route ────────────────────────────────────────────────────────────────
# City name or IATA code (VIENNA == VIE, COPENHAGEN == CPH)
FROM=VIENNA
TO=COPENHAGEN

# Round-trip search window: day range, month, year.
# "26-30" = 26th..30th. A range that wraps (e.g. 28-3) rolls into next month.
DEPARTURE_DAY_RANGE=26-30
DEPARTURE_MONTH=12
DEPARTURE_YEAR=2026

RETURN_DAY_RANGE=2-5
RETURN_MONTH=1
RETURN_YEAR=2027

# ─── Search ───────────────────────────────────────────────────────────────
CURRENCY=EUR
ADULTS=1
SEAT_CLASS=economy
# MAX_STOPS=0
# PROXY=

# ─── Polling ──────────────────────────────────────────────────────────────
POLL_INTERVAL_MIN=180
POLL_JITTER_MIN=10
POLL_PAIRS_PER_CYCLE=0
REQUEST_DELAY_SEC=3
RETRY_COUNT=2
RETRY_DELAY_SEC=20

# ─── Alerts ───────────────────────────────────────────────────────────────
ALERT_MIN_DROP_ABS=1
ALERT_MIN_DROP_PCT=0
ALERT_ON_FIRST_RUN=false
ALERT_COOLDOWN_H=3

# ─── Signal ───────────────────────────────────────────────────────────────
# signal-cli | http | none
SIGNAL_MODE=signal-cli
SIGNAL_ACCOUNT=+43XXXXXXXXX
SIGNAL_RECIPIENTS=+43XXXXXXXXX,+45XXXXXXXXX
# SIGNAL_API_URL=http://127.0.0.1:8080

# ─── Web dashboard ────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8099
# WEB_USER=
# WEB_PASS=
# Link used in Signal replies (auto-detected from the machine IP when empty)
# PUBLIC_URL=http://203.0.113.10:8099/

# ─── Signal commands ──────────────────────────────────────────────────────
# Listen for "stats" / "help" messages and answer them
# INBOX_ENABLED=true
# Message language: en | ru  (alerts + replies)
# LANGUAGE=en
# Per-recipient override, e.g. girlfriend in Russian:
# SIGNAL_LANGUAGES=+45XXXXXXXXX:ru

# ─── Files ────────────────────────────────────────────────────────────────
DB_PATH=data/prices.db
LOG_PATH=data/trackfly.log
